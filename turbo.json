{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "bench": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "bench:cold": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "bench:fastly": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
